<resources>
    <!-- Shared shape scale and type; colors live in AppTheme (light) and values-night (dark). -->
    <style name="ShapeAppearance.CloudIDE.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.CloudIDE.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.CloudIDE.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="TextAppearance.CloudIDE.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.CloudIDE.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CloudIDE.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CloudIDE.Large</item>
    </style>

    <!-- Light: cool mist surfaces, deep lagoon primary, amber only for build actions -->
    <style name="AppTheme" parent="Base.AppTheme">
        <item name="colorPrimary">#006B5E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#A7F2E3</item>
        <item name="colorOnPrimaryContainer">#00201B</item>
        <item name="colorSecondary">#456268</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#C9E8EF</item>
        <item name="colorOnSecondaryContainer">#001F25</item>
        <item name="colorTertiary">#835400</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFDDB0</item>
        <item name="colorOnTertiaryContainer">#2A1800</item>
        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFDAD6</item>
        <item name="colorOnErrorContainer">#410002</item>
        <item name="colorSurface">#F3F8F8</item>
        <item name="colorOnSurface">#121C1F</item>
        <item name="colorSurfaceVariant">#D5E3E6</item>
        <item name="colorOnSurfaceVariant">#3F5358</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#EEF4F5</item>
        <item name="colorSurfaceContainer">#E7EFF0</item>
        <item name="colorSurfaceContainerHigh">#E0E9EA</item>
        <item name="colorSurfaceContainerHighest">#D9E3E5</item>
        <item name="colorOutline">#6E8387</item>
        <item name="colorOutlineVariant">#BFD0D4</item>
        <item name="android:colorBackground">#F3F8F8</item>
        <item name="colorOnBackground">#121C1F</item>
    </style>
</resources>
